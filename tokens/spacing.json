{
  "$schema": "https://uniodonto.design/schemas/tokens-v1.json",
  "version": "1.0.0",
  "description": "Escala de espaçamento base 4px. Todos os paddings, margins e gaps devem usar estes tokens.",
  "rules": [
    "NUNCA usar valores de espaçamento fora desta escala.",
    "Componentes compactos (badges, inputs pequenos): 1, 2, 3.",
    "Componentes padrão (botões, cards): 3, 4, 6.",
    "Seções de página: 8, 12, 16, 24."
  ],
  "scale": {
    "0": "0px",
    "0.5": "2px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px"
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px rgba(129, 14, 86, 0.06)",
    "sm": "0 2px 6px rgba(129, 14, 86, 0.08)",
    "md": "0 8px 20px rgba(129, 14, 86, 0.10)",
    "lg": "0 16px 40px rgba(129, 14, 86, 0.14)",
    "focus": "0 0 0 3px rgba(191, 156, 255, 0.45)"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "containerMax": "1280px",
    "pagePadding": { "mobile": "16px", "tablet": "32px", "desktop": "48px" }
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "360ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)"
    }
  }
}
